#!/usr/bin/env bash
#
# smarter-dia
# Comprehensive Management & Intelligence Supercharger Engine for Dia AI Browser Agent
# Author: Ganidhu LifeOS

set -e

DIST="/Applications/Dia.app/Contents/Resources/agent-server-resources/dist"
PROMPT_DIR="$DIST/prompts/mixins"
SKILLS_DIR="$DIST/prompts/skills"
CHAT_BASE="$DIST/prompts/chat-base.md"
SCRATCH_DIR="$HOME/.gemini/antigravity-cli/brain/b3cbdaf8-637f-486b-8352-d347445db679/scratch"
AGY_SKILLS="$HOME/.agents/skills"
USER_AGENTS_MD="/Users/ganidhu/AGENTS.md"

# Terminal Colors & Icons
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
BOLD='\033[1m'
NC='\033[0m'

banner() {
    echo -e "${CYAN}${BOLD}"
    echo "  ___                 _             ___  _ "
    echo " / __|_ __  __ _ _ _| |_ ___ _ _   |   \| |"
    echo " \__ \ '  \/ _\` | '_|  _/ -_) '_|  | |) | |"
    echo " |___/_|_|_\__,_|_|  \__\___|_|    |___/|_|"
    echo -e "${NC}${MAGENTA}       Dia AI Intelligence & Sandbox Supercharger Engine${NC}\n"
}

check_status() {
    banner
    echo -e "${BOLD}=== [ 1. Sandbox Capabilities ] ===${NC}"
    if [ ! -d "$DIST" ]; then
        echo -e "  ${RED}✘ Dia app bundle not found at $DIST${NC}"
        exit 1
    fi

    if grep -q "(allow process-exec)" "$DIST/agent-claude-code.sb" 2>/dev/null; then
        echo -e "  ${GREEN}✔ agent-claude-code.sb: UNLOCKED (Full Shell & Process Exec)${NC}"
    else
        echo -e "  ${YELLOW}⚠️ agent-claude-code.sb: RESTRICTED${NC}"
    fi

    if grep -q "(allow process-exec)" "$DIST/agent.sb" 2>/dev/null; then
        echo -e "  ${GREEN}✔ agent.sb: UNLOCKED (Full Server Process Exec)${NC}"
    else
        echo -e "  ${YELLOW}⚠️ agent.sb: RESTRICTED${NC}"
    fi

    if grep -q "macOS environment with full shell access" "$PROMPT_DIR/sandbox-constraints.md" 2>/dev/null; then
        echo -e "  ${GREEN}✔ sandbox-constraints.md: UNLOCKED PROMPT${NC}"
    else
        echo -e "  ${YELLOW}⚠️ sandbox-constraints.md: RESTRICTED PROMPT${NC}"
    fi

    echo -e "\n${BOLD}=== [ 2. Binary & PATH Symlinks ] ===${NC}"
    for tool in yt-dlp ffmpeg node python3 git bun uv; do
        if [ -x "/usr/local/bin/$tool" ] || [ -x "/opt/homebrew/bin/$tool" ]; then
            echo -e "  ${GREEN}✔ $tool: AVAILABLE${NC}"
        else
            echo -e "  ${YELLOW}⚠️ $tool: NOT LINKED IN /usr/local/bin${NC}"
        fi
    done

    echo -e "\n${BOLD}=== [ 3. AGY Skills Sync ] ===${NC}"
    if [ -d "$SKILLS_DIR" ]; then
        total_skills=$(ls -1d "$SKILLS_DIR"/*/ 2>/dev/null | wc -l | tr -d ' ')
        echo -e "  ${GREEN}✔ Total Skills Loaded in Dia: $total_skills${NC}"
    fi

    echo -e "\n${BOLD}=== [ 4. Path Override & AGENTS.md Persona ] ===${NC}"
    if grep -q "user_path_override" "$CHAT_BASE" 2>/dev/null; then
        echo -e "  ${GREEN}✔ /Users/ganidhu Path Override Appended to chat-base.md${NC}"
    else
        echo -e "  ${YELLOW}⚠️ Path Override not yet appended${NC}"
    fi

    if grep -q "Ganidhu Context" "$CHAT_BASE" 2>/dev/null; then
        echo -e "  ${GREEN}✔ Ganidhu AGENTS.md persona Appended to chat-base.md${NC}"
    else
        echo -e "  ${YELLOW}⚠️ AGENTS.md persona not yet appended${NC}"
    fi
    echo ""
}

unlock_sandbox() {
    echo -e "${BOLD}Applying Full Capabilities Unlock...${NC}"
    
    if [ "$EUID" -ne 0 ]; then
        exec sudo "$0" unlock "$@"
    fi

    # Backups
    [ -f "$DIST/agent-claude-code.sb.bak" ] || cp "$DIST/agent-claude-code.sb" "$DIST/agent-claude-code.sb.bak"
    [ -f "$DIST/agent.sb.bak" ] || cp "$DIST/agent.sb" "$DIST/agent.sb.bak"
    [ -f "$PROMPT_DIR/sandbox-constraints.md.bak" ] || cp "$PROMPT_DIR/sandbox-constraints.md" "$PROMPT_DIR/sandbox-constraints.md.bak"

    if [ -f "$SCRATCH_DIR/agent-claude-code.sb" ]; then
        cp "$SCRATCH_DIR/agent-claude-code.sb" "$DIST/agent-claude-code.sb"
        cp "$SCRATCH_DIR/agent.sb" "$DIST/agent.sb"
        cp "$SCRATCH_DIR/sandbox-constraints.md" "$PROMPT_DIR/sandbox-constraints.md"
        echo -e "  ${GREEN}✔ Sandbox files and prompt successfully updated!${NC}"
    fi
}

fix_path_links() {
    echo -e "${BOLD}Fixing System PATH Symlinks...${NC}"
    if [ "$EUID" -ne 0 ]; then
        exec sudo "$0" fix-path "$@"
    fi

    mkdir -p /usr/local/bin
    for binary in yt-dlp ffmpeg ffprobe python3 node npm bun git uv gh; do
        target=$(which $binary 2>/dev/null || true)
        if [ -n "$target" ] && [ "$target" != "/usr/local/bin/$binary" ]; then
            ln -sf "$target" "/usr/local/bin/$binary"
            echo -e "  ${GREEN}✔ Symlinked $target -> /usr/local/bin/$binary${NC}"
        fi
    done
}

sync_skills() {
    echo -e "${BOLD}Syncing AGY Skills to Dia...${NC}"
    if [ "$EUID" -ne 0 ]; then
        exec sudo "$0" sync-skills "$@"
    fi

    if [ -d "$AGY_SKILLS" ]; then
        for skill in "$AGY_SKILLS"/*; do
            if [ -d "$skill" ]; then
                name=$(basename "$skill")
                cp -R "$skill" "$SKILLS_DIR/$name" 2>/dev/null || true
            fi
        done
        echo -e "  ${GREEN}✔ Copied all AGY skills to $SKILLS_DIR${NC}"
    fi
}

append_prompt_rules() {
    echo -e "${BOLD}Appending Path Override & AGENTS.md Persona to chat-base.md...${NC}"
    if [ "$EUID" -ne 0 ]; then
        exec sudo "$0" append-prompt "$@"
    fi

    [ -f "$CHAT_BASE.bak" ] || cp "$CHAT_BASE" "$CHAT_BASE.bak"

    # 1. Append Path Override block safely
    if ! grep -q "user_path_override" "$CHAT_BASE"; then
        cat << 'EOF' >> "$CHAT_BASE"

<user_path_override>
- CRITICAL PATH RESOLUTION RULE:
- The user's real home directory on macOS is strictly `/Users/ganidhu`.
- Inside this agent runner environment, `~` or `$HOME` resolves to the sandboxed working context folder (`.../AgentServer/contexts/.../work`).
- Whenever looking for user files, reading configs, running CLI tools (`yt-dlp`, `ffmpeg`, `git`, `python3`, etc.), or targeting home directory files, ALWAYS use `/Users/ganidhu/...` explicitly instead of `~/...`.
</user_path_override>
EOF
        echo -e "  ${GREEN}✔ Appended /Users/ganidhu path resolution rule to chat-base.md${NC}"
    fi

    # 2. Append AGENTS.md persona block safely
    if [ -f "$USER_AGENTS_MD" ] && ! grep -q "Ganidhu Context" "$CHAT_BASE"; then
        echo -e "\n\n<user_custom_instructions>\n$(cat "$USER_AGENTS_MD")\n</user_custom_instructions>" >> "$CHAT_BASE"
        echo -e "  ${GREEN}✔ Appended AGENTS.md persona rules to chat-base.md${NC}"
    fi
}

full_supercharge() {
    banner
    unlock_sandbox
    fix_path_links
    sync_skills
    append_prompt_rules
    echo -e "\n${GREEN}${BOLD}✨ Dia is now Smarter-Dia! Restart Dia (Cmd+Q) to reload.${NC}\n"
}

case "$1" in
    unlock)
        unlock_sandbox
        ;;
    fix-path)
        fix_path_links
        ;;
    sync-skills)
        sync_skills
        ;;
    persona|append-prompt)
        append_prompt_rules
        ;;
    supercharge|repair|fix|all)
        full_supercharge
        ;;
    status|check|"")
        check_status
        ;;
    *)
        check_status
        echo -e "${BOLD}Commands:${NC}"
        echo "  smarter-dia status          # Diagnostic check"
        echo "  smarter-dia supercharge     # Full upgrade (unlock, PATH links, AGY skills, prompt appends)"
        echo "  smarter-dia unlock          # Unlock sandbox execution"
        echo "  smarter-dia fix-path        # Symlink binaries into /usr/local/bin"
        echo "  smarter-dia sync-skills      # Sync AGY skills into Dia"
        echo "  smarter-dia append-prompt   # Safely append path rules & persona to chat-base.md"
        ;;
esac
